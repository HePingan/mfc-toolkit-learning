{
  "name": "mfc-toolkit-learning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "bash scripts/deploy-static.sh",
    "verify:routes": "node scripts/verify-routes.mjs",
    "verify:navigation": "node scripts/verify-navigation.mjs",
    "verify:bundle": "node scripts/verify-bundle-budget.mjs",
    "verify:styles": "node scripts/verify-style-architecture.mjs",
    "verify:mobile": "node scripts/verify-mobile.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "jszip": "^3.10.1",
    "lucide-react": "0.468.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-router-dom": "6.30.2",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^2.1.9"
  }
}
